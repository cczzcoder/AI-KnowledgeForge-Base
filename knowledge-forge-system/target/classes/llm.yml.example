# ============================================
# KnowledgeForge AI — LLM 配置模板
# 复制本文件为 llm.yml 并填入您的实际配置
# llm.yml 已被 .gitignore 忽略，不会提交到仓库
# ============================================

spring:
  ai:
    openai:
      api-key: ${AI_API_KEY}                       # 必填：您的 API Key
      base-url: ${AI_BASE_URL:https://api.siliconflow.cn}   # API 地址（默认硅基流动）
      chat:
        options:
          model: ${AI_CHAT_MODEL:deepseek-ai/DeepSeek-V3.2}   # 对话模型
          temperature: 0.7
      embedding:
        options:
          model: ${AI_EMBEDDING_MODEL:BAAI/bge-large-zh-v1.5}  # 向量化模型
    vectorstore:
      pgvector:
        initialize-schema: false
        index-type: hnsw
        distance-type: cosine_distance
        dimensions: 1024
        vector-table-name: vector_store