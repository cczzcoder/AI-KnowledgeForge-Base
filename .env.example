# 环境变量配置模板
# 复制本文件为 .env 并填入实际配置值
# .env 已被 .gitignore 忽略，不会提交到仓库

# 数据库密码（必填）
PG_PASSWORD=your_db_password

# MinIO 对象存储（默认 minioadmin/minioadmin）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# AI API Key（必填）
AI_API_KEY=your_api_key

# AI API 地址（可选，默认硅基流动）
AI_BASE_URL=https://api.siliconflow.cn

# 对话模型（可选）
AI_CHAT_MODEL=deepseek-ai/DeepSeek-V3.2

# 向量化模型（可选）
AI_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5