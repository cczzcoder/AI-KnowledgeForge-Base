# 数据库密码（与 docker-compose 默认值一致）
PG_PASSWORD=kf_pass_2024

# MinIO 对象存储
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# AI API Key（必填，请替换为你的实际 API Key）
AI_API_KEY=your_api_key_here

# AI API 地址（默认硅基流动）
AI_BASE_URL=https://api.siliconflow.cn

# 对话模型
AI_CHAT_MODEL=deepseek-ai/DeepSeek-V3.2

# 向量化模型
AI_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5